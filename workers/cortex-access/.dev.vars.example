# Optional deterministic chat model settings. Chat also requires configured retrieval.
# The default local MCP server has no remote model or Vectorize binding:
MODEL_API_URL=http://127.0.0.1:8899/v1/chat/completions
MODEL_API_GATEWAY_ID=
MODEL_NAME=mock-deterministic-model
MODEL_API_TOKEN=local-mock-only-not-a-secret
CHAT_ENABLED=false
ENVIRONMENT=development
CORTEX_ALLOWED_ORIGINS=http://127.0.0.1:8080
MCP_ENABLED=true
MCP_ALLOWED_HOSTNAMES=localhost,127.0.0.1
MCP_ALLOWED_ORIGINS=http://127.0.0.1:8080
