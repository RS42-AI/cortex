{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cortex-local",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-08",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "vars": {
    "CHAT_ENABLED": "false",
    "CORTEX_ALLOWED_ORIGINS": "http://127.0.0.1:8080",
    "ENVIRONMENT": "development",
    "MCP_ENABLED": "true",
    "MCP_ALLOWED_HOSTNAMES": "localhost,127.0.0.1",
    "MCP_ALLOWED_ORIGINS": "http://127.0.0.1:8080",
    "MODEL_API_URL": "",
    "MODEL_API_GATEWAY_ID": "",
    "MODEL_NAME": "",
  },
}
